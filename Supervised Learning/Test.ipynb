   "source": [
    "import numpy as np\n",
    "\n",
    "y = 1\n",
    "prediction = 0.01\n",
    "\n",
    "cost = -(\n",
    "    y * np.log(prediction)\n",
    "    + (1-y) * np.log(1-prediction)\n",
    ")\n",
    "\n",
    "print(cost)"
   ]
